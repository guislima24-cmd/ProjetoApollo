{
  "manifest_version": 3,
  "name": "ProspectAI — UFABC Júnior",
  "version": "1.9.1",
  "key": "",
  "description": "Captura prospecções feitas no LinkedIn e registra automaticamente na planilha CRM.",

  "permissions": [
    "storage",
    "cookies",
    "notifications",
    "activeTab",
    "tabs",
    "scripting"
  ],

  "host_permissions": [
    "https://www.linkedin.com/*",
    "https://linkedin.com/*",
    "https://app.apollo.io/*",
    "http://localhost:3000/*",
    "https://projeto-apollo.vercel.app/*"
  ],

  "background": {
    "service_worker": "background.js",
    "type": "module"
  },

  "content_scripts": [
    {
      "matches": ["https://www.linkedin.com/*"],
      "js": ["interceptor.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://www.linkedin.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "world": "ISOLATED"
    },
    {
      "matches": ["https://app.apollo.io/*"],
      "js": ["apollo-interceptor.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://www.linkedin.com/messaging/*"],
      "js": ["reply-detector.js"],
      "run_at": "document_idle",
      "world": "ISOLATED"
    },
    {
      "matches": ["https://www.linkedin.com/mynetwork/*"],
      "js": ["acceptance-detector.js"],
      "run_at": "document_idle",
      "world": "ISOLATED"
    }
  ],

  "action": {
    "default_popup": "popup.html",
    "default_title": "ProspectAI"
  },

  "icons": {
    "16":  "icons/icon16.png",
    "48":  "icons/icon48.png",
    "128": "icons/icon128.png"
  },

  "externally_connectable": {
    "matches": [
      "http://localhost:3000/*",
      "https://projeto-apollo.vercel.app/*"
    ]
  }
}
