# ─── Google OAuth (obrigatório) ───────────────────────────────────────────────
# Crie em: console.cloud.google.com → APIs → Credenciais → OAuth 2.0
# URI de redirecionamento autorizado: https://seu-dominio.vercel.app/api/auth/callback/google
# (adicione também http://localhost:3000/api/auth/callback/google para dev)
GOOGLE_CLIENT_ID="seu-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="seu-client-secret"

# ─── NextAuth (obrigatório) ────────────────────────────────────────────────────
# Gere com: openssl rand -hex 32
AUTH_SECRET="cole-aqui-32-ou-mais-caracteres-aleatorios"

# URL base da aplicação (sem barra no final)
# Em dev: http://localhost:3000   |   Em prod: https://seu-dominio.vercel.app
NEXTAUTH_URL="http://localhost:3000"

# ─── Google Sheets Service Account (obrigatório) ──────────────────────────────
# Crie em: console.cloud.google.com → Service Accounts → Keys → Add key → JSON
# Compartilhe a planilha com o email do service account como Editor.
#
# Opção A (preferida): JSON inteiro em uma única env
GOOGLE_CREDENTIALS_JSON='{"type":"service_account","project_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n","client_email":"prospectai@seu-projeto.iam.gserviceaccount.com"}'

# Opção B: par separado (fallback)
# GOOGLE_SERVICE_ACCOUNT_EMAIL="prospectai@seu-projeto.iam.gserviceaccount.com"
# GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# ID da planilha CRM.
# Deixe vazio para criar uma nova automaticamente via POST /api/sheets/setup.
# Após criar, copie o ID retornado e cole aqui.
GOOGLE_SHEETS_ID=""

# ─── Anthropic / Claude ───────────────────────────────────────────────────────
# Necessário apenas se usuários usarem o modelo Claude Haiku.
ANTHROPIC_API_KEY="sk-ant-..."

# ─── Google AI Studio / Gemini (padrão — gratuito) ───────────────────────────
# Obtenha em: aistudio.google.com/app/apikey
# Limite gratuito: 1.500 req/dia, 1 M tokens/min
GEMINI_API_KEY="AIza..."

# ─── Pipeline de descoberta de leads (/descoberta) ───────────────────────────

# Brasil.io — busca de empresas por CNPJ público (OBRIGATÓRIO para descoberta)
# Token gratuito em: https://brasil.io/api-token/
# (crie conta, vá em Perfil → Token da API)
BRASIL_IO_TOKEN=""

# Phantombuster — enriquecimento via LinkedIn (OPCIONAL)
# Se não configurado, leads são descobertos sem dados de LinkedIn.
# 1. Crie conta em: https://phantombuster.com
# 2. Vá em Settings → API Key para obter PHANTOMBUSTER_API_KEY
# 3. Adicione o agente "LinkedIn Company Scraper" e copie o ID
# PHANTOMBUSTER_API_KEY="seu-token-aqui"
# PHANTOMBUSTER_COMPANY_AGENT_ID="id-do-agente-aqui"

# ─── Opcional ─────────────────────────────────────────────────────────────────
# Envio de email via Resend (rota /api/send)
# RESEND_API_KEY="re_..."
